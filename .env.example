# APP_URL: The public URL where this site is hosted (e.g. https://clearanestate.com).
# Used as a fallback origin for Stripe checkout redirects.
APP_URL="MY_APP_URL"

# Stripe Integration Credentials
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# MySQL Database (for the directory listings + submission queue)
# On Namecheap cPanel, create a database + user under "MySQL Databases" and use those values here.
#
# IMPORTANT: On shared hosting (Namecheap cPanel), use Unix socket connection instead of TCP:
# DB_SOCKET=/var/lib/mysql/mysql.sock
# (TCP connections via host:port are restricted on shared hosting due to CageFS isolation)
#
# For local development or VPS/Dedicated, use TCP connection:
# DB_HOST=127.0.0.1
# DB_PORT=3306
#
# Choose one method above, then set these:
DB_USER=
DB_PASSWORD=
DB_NAME=

# Admin Portal password - required to approve/reject submissions and manage live listings
# once a database is configured. Leave blank to keep the admin API locked down.
ADMIN_PASSWORD=

# Where to send a heads-up email when a new listing submission, estimate request, or
# claim request needing manual review comes in. Requires SMTP_* below to also be set.
# Leave blank to skip notifications - you'd then need to check the Admin Portal manually.
ADMIN_NOTIFICATION_EMAIL=

# SMTP (for delivering "Request Estimate" quote requests to the listed business).
# On Namecheap cPanel, create a mailbox under "Email Accounts" and use its SMTP settings here.
# If left blank, quote requests are still saved to the database but no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
